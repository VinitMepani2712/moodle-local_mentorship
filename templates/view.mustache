{{!
    @template local_mentorship/view

    Pairing page: the mentee's training report.

    Context variables required for this template:
    * backurl, backlabel - Back link
    * hasselector, selectorprompt, selector - Mentee selector [{url, label, selected}]
    * name, picture, mentoredby, active, status - Header
    * profileurl, hastranscript, transcripturl, hasmessage, messageurl, messagelabel - Header actions
    * stats - [{cls, icon, value, label}]
    * filters - See local_mentorship/report_filters
    * hascourses, courses - See local_mentorship/report_course

    Example context (json):
    {
        "backurl": "#", "backlabel": "Back to My mentorship",
        "hasselector": true, "selectorprompt": false,
        "selector": [{"url": "#", "label": "Jordan Rivera", "selected": true}],
        "name": "Jordan Rivera", "picture": "", "mentoredby": "Mentored by Maria Santos",
        "active": true, "status": "Active",
        "profileurl": "#", "hastranscript": false, "transcripturl": "",
        "hasmessage": true, "messageurl": "#", "messagelabel": "Message Jordan Rivera",
        "stats": [{"cls": "stat-total", "icon": "fa-book", "value": 4, "label": "Total courses"}],
        "filters": {},
        "hascourses": false, "courses": []
    }
}}
<div id="egr-wrapper" data-region="local-mentorship-report">
    <a class="egr-back" href="{{backurl}}"><i class="fa fa-chevron-left" aria-hidden="true"></i> {{backlabel}}</a>

    {{#hasselector}}
        <div class="egr-mentee-selector">
            <div class="egr-mentee-inner">
                <label class="egr-mentee-label" for="egr-mentee-select">
                    <i class="fa fa-users" aria-hidden="true"></i> {{#str}} report:selectmentee, local_mentorship {{/str}}
                </label>
                <select id="egr-mentee-select" class="egr-mentee-dropdown" data-action="select-mentee">
                    {{#selectorprompt}}
                        <option value="" selected disabled>{{#str}} report:selectmentee, local_mentorship {{/str}}</option>
                    {{/selectorprompt}}
                    {{#selector}}
                        <option value="{{url}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/selector}}
                </select>
            </div>
        </div>
    {{/hasselector}}

    <div class="egr-user-header">
        {{{picture}}}
        <div class="egr-user-info">
            <h2 class="egr-user-name">{{name}}</h2>
            <div class="egr-user-meta">
                <span class="egr-user-status {{#active}}egr-user-status-active{{/active}}">{{status}}</span>
                <span>{{mentoredby}}</span>
            </div>
        </div>
        <div class="egr-user-actions">
            {{#hasmessage}}
                <a href="{{messageurl}}" class="btn btn-primary btn-sm" aria-label="{{messagelabel}}">
                    <i class="fa fa-comment" aria-hidden="true"></i> {{#str}} message, local_mentorship {{/str}}
                </a>
            {{/hasmessage}}
            <a href="{{profileurl}}" target="_blank" class="btn btn-primary btn-sm">{{#str}} report:profile, local_mentorship {{/str}}</a>
            {{#hastranscript}}
                <a href="{{transcripturl}}" target="_blank" class="btn btn-primary btn-sm">{{#str}} report:transcript, local_mentorship {{/str}}</a>
            {{/hastranscript}}
        </div>
    </div>

    <div class="egr-stats-row">
        {{#stats}}
            <div class="egr-stat-card {{cls}}">
                <div class="egr-stat-icon"><i class="fa {{icon}}" aria-hidden="true"></i></div>
                <div class="egr-stat-value">{{value}}</div>
                <div class="egr-stat-label">{{label}}</div>
            </div>
        {{/stats}}
    </div>

    {{#filters}}{{> local_mentorship/report_filters }}{{/filters}}

    {{#hascourses}}
        <div class="egr-report-table-wrapper">
            {{#courses}}{{> local_mentorship/report_course }}{{/courses}}
        </div>
    {{/hascourses}}
    {{^hascourses}}
        <div class="alert alert-info mt-3">{{#str}} report:nocourses, local_mentorship {{/str}}</div>
    {{/hascourses}}
</div>
