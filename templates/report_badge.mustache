{{!
    @template local_mentorship/report_badge

    Status badge.

    Context variables required for this template:
    * cls - completed|inprogress|notattempted|overdue|failed|nottracked
    * icon - Font Awesome classes
    * label - Status label

    Example context (json):
    {"cls": "completed", "icon": "fa-check-circle", "label": "Completed"}
}}
<span class="egr-badge egr-badge-{{cls}}"><i class="fa {{icon}}" aria-hidden="true"></i> {{label}}</span>
